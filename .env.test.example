# Projet Supabase de TEST (« boutique-test ») — jamais la production.
# Copie ce fichier en .env.test et remplis les valeurs (Settings → API).

# URL du projet de test, ex. https://abcdefgh.supabase.co
SUPABASE_URL=https://xxxx-test.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://xxxx-test.supabase.co

# Clé anon du projet de test
EXPO_PUBLIC_SUPABASE_ANON_KEY=colle-ici-la-cle-anon-du-projet-test

# Clé service_role du projet de test (scripts admin / seed uniquement)
SUPABASE_SERVICE_ROLE_KEY=colle-ici-la-cle-service-role-du-projet-test
